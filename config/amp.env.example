# Baseline for an AMP that talks to Impala HS2 and nothing else.
# Encrypt with sops after .sops.yaml names this project's age recipient:
#
#   cp config/amp.env.example .env.cai
#   sops encrypt --input-type dotenv --output-type dotenv .env.cai > .env.cai.enc
#   rm .env.cai
#
# scripts/bootstrap-secrets.sh decrypts .env.cai.enc when SOPS_AGE_KEY
# or SOPS_AGE_KEY_FILE is set. The devenv shell does not run it.

OPTAGENT_POSTURE=amp
IMPALA_HS2_HOST=
IMPALA_HS2_PORT=21050
IMPALA_DATABASE=optagent
IMPALA_AUTH=kerberos
IMPALA_KRB_PRINCIPAL=
IMPALA_KRB_KEYTAB=
OPTAGENT_CDE_ENABLED=false
OPTAGENT_TRACES_S3_URI=
OPTAGENT_SAMPLE_MODE=true
OPTAGENT_SNAPSHOT_S3_URI=s3://signals-snapshots/sample/workspace
OPTAGENT_SNAPSHOT_ENDPOINT=
