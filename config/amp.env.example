# Baseline for an AMP that talks to Impala HS2 and nothing else.
# Encrypt with sops after .sops.yaml names this project's age recipient:
#
#   cp config/amp.env.example .env.cai
#   sops encrypt --input-type dotenv --output-type dotenv .env.cai > .env.cai.enc
#   rm .env.cai
#
# scripts/bootstrap-secrets.sh decrypts .env.cai.enc when SOPS_AGE_KEY
# or SOPS_AGE_KEY_FILE is set. The devenv shell does not run it.

OPTAGENT_POSTURE=amp
IMPALA_HS2_HOST=
IMPALA_HS2_PORT=21050
IMPALA_DATABASE=optagent
IMPALA_AUTH=kerberos
IMPALA_KRB_PRINCIPAL=
IMPALA_KRB_KEYTAB=
OPTAGENT_CDE_ENABLED=false
OPTAGENT_TRACES_S3_URI=
OPTAGENT_SAMPLE_MODE=true
OPTAGENT_SNAPSHOT_S3_URI=s3://signals-snapshots/sample/workspace
OPTAGENT_SNAPSHOT_ENDPOINT=

# Grok Build stays the harness. Empty base URL keeps Grok's built-in catalog.
# Set the URL to an OpenAI-compatible /v1 endpoint. Put the key in
# OPTAGENT_MODEL_API_KEY (SOPS). Do not put the key in the URL or in git.
OPTAGENT_MODEL=
OPTAGENT_MODEL_NAME=
OPTAGENT_MODEL_BASE_URL=
OPTAGENT_MODEL_API_KEY_ENV=OPTAGENT_MODEL_API_KEY
OPTAGENT_MODEL_BACKEND=chat_completions
# OPTAGENT_MODELS_JSON=[{"id":"local","model":"qwen","base_url":"http://127.0.0.1:8000/v1","api_key_env":"OPTAGENT_MODEL_API_KEY","backend":"chat_completions"}]
# Mistral under the same harness. Select with OPTAGENT_MODEL=mistral
# or OPTAGENT_MODEL=mistral-studio. Keys stay in these variables.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_WORKSPACE_API_KEY=
# MISTRAL_WORKSPACE_ID=
# MISTRAL_WORKSPACE_MODEL=mistral-small-latest
